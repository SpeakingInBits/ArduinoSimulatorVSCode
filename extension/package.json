{
  "name": "metro-simulator",
  "displayName": "Metro M0 Simulator",
  "description": "Build circuits and test CircuitPython on a simulated Adafruit Metro M0 Express, without a physical board.",
  "version": "0.1.0",
  "publisher": "speakinginbits",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/SpeakingInBits/ArduinoSimulatorVSCode" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Education", "Other"],
  "main": "./extension.cjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/circuit.test.js test/console.test.js test/layout3d.test.js test/diagram.test.js",
    "test:e2e": "node scripts/run-e2e.js",
    "assets": "node scripts/copy-assets.js"
  },
  "activationEvents": ["workspaceContains:**/circuit.json"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "metroSim.diagram",
        "displayName": "Circuit Diagram",
        "selector": [{ "filenamePattern": "circuit.json" }],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "metroSim.open", "title": "Open Circuit Simulator", "category": "Metro Simulator" },
      { "command": "metroSim.diagram", "title": "Show Circuit Diagram", "category": "Metro Simulator" },
      { "command": "metroSim.run", "title": "Run on Simulator", "category": "Metro Simulator", "icon": "$(play)" },
      { "command": "metroSim.stop", "title": "Stop Simulator", "category": "Metro Simulator", "icon": "$(debug-stop)" },
      { "command": "metroSim.newProject", "title": "New Project from Example", "category": "Metro Simulator" },
      { "command": "metroSim.addLibrary", "title": "Add Library to Project", "category": "Metro Simulator" },
      { "command": "metroSim.setupEditor", "title": "Set Up CircuitPython Autocomplete", "category": "Metro Simulator" },
      { "command": "metroSim.copyToBoard", "title": "Copy Project to CIRCUITPY Drive", "category": "Metro Simulator" }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "metroSim.run", "when": "resourceLangId == python", "group": "navigation" }
      ]
    }
  }
}
