# The module set follows ports/atmel-samd/mpconfigport.mk for a SAMD21 Express board, plus
# boards/metro_m0_express/mpconfigboard.mk, so students get the same language as the real M0.
CHIP_FAMILY ?= samd21
LONGINT_IMPL ?= MPZ
INTERNAL_LIBM = 1
INTERNAL_FLASH_FILESYSTEM = 1
CIRCUITPY_BUILD_EXTENSIONS ?= js

# Port plumbing.
CIRCUITPY_PORT_SERIAL = 1
CIRCUITPY_USB_DEVICE = 0
CIRCUITPY_SKIP_SAFE_MODE_WAIT = 1
CIRCUITPY_LTO = 0
CIRCUITPY_OPTIMIZE_PROPERTY_FLASH_SIZE = 0
CIRCUITPY_COMPUTED_GOTO_SAVE_SPACE = 0
CIRCUITPY_DIGITALINOUT_PROTOCOL = 0

# emcc is Clang, which reports an old GCC version. The check targets GCC miscompiles.
CIRCUITPY_MIN_GCC_VERSION = 0

# From boards/metro_m0_express/mpconfigboard.mk.
CIRCUITPY_CODEOP = 0
CIRCUITPY_ERRNO = 0
CIRCUITPY_RAINBOWIO = 0

# From the samd21 section of ports/atmel-samd/mpconfigport.mk.
CIRCUITPY_AESIO = 0
CIRCUITPY_ATEXIT = 0
CIRCUITPY_AUDIOMIXER = 0
CIRCUITPY_AUDIOMP3 = 0
CIRCUITPY_BINASCII = 0
CIRCUITPY_BITBANGIO = 0
CIRCUITPY_BITMAPFILTER = 0
CIRCUITPY_BITMAPTOOLS = 0
CIRCUITPY_BLEIO_HCI = 0
CIRCUITPY_BUILTINS_POW3 = 0
CIRCUITPY_BUSDEVICE = 0
CIRCUITPY_COUNTIO = 0
CIRCUITPY_FRAMEBUFFERIO = 0
CIRCUITPY_FREQUENCYIO = 0
CIRCUITPY_GETPASS = 0
CIRCUITPY_GIFIO = 0
CIRCUITPY_I2CTARGET = 0
CIRCUITPY_JSON = 0
CIRCUITPY_KEYPAD = 0
CIRCUITPY_KEYPAD_DEMUX = 0
CIRCUITPY_LVFONTIO = 0
CIRCUITPY_MSGPACK = 0
CIRCUITPY_PIXELMAP = 0
CIRCUITPY_RE = 0
CIRCUITPY_SDCARDIO = 0
CIRCUITPY_SETTINGS_TOML = 0
CIRCUITPY_SPITARGET = 0
CIRCUITPY_SYNTHIO = 0
CIRCUITPY_TERMINALIO_VT100 = 0
CIRCUITPY_TILEPALETTEMAPPER = 0
CIRCUITPY_TRACEBACK = 0
CIRCUITPY_ULAB = 0
CIRCUITPY_VECTORIO = 0
CIRCUITPY_ZLIB = 0
MICROPY_PY_ASYNC_AWAIT = 0

# Python's USB modules, without USB. See supervisor/usb_sim.c. CIRCUITPY_USB_DEVICE stays off, so
# the Makefile adds their sources.
CIRCUITPY_USB_CDC = 1
CIRCUITPY_USB_HID = 1
CIRCUITPY_USB_MIDI = 1

# The real board uses its own touch hardware, as this port does through the simulator.
CIRCUITPY_TOUCHIO_USE_NATIVE = 1
# The real board decodes the encoder in C. Here the simulator does, so the port supplies position.
CIRCUITPY_ROTARYIO_SOFTENCODER = 0

